cmake_minimum_required(VERSION 3.20)
set(root "${CMAKE_CURRENT_LIST_DIR}/..")
set(work "${CMAKE_CURRENT_BINARY_DIR}/tmp/isolated_custom_command")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/noncmake" "${work}/consumer")
file(WRITE "${work}/noncmake/README.txt" "custom build fixture\n")
file(TO_CMAKE_PATH "${root}/cmake/CppDeps.cmake" module)
file(TO_CMAKE_PATH "${work}/noncmake" source)
file(WRITE "${work}/consumer/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.20)
project(custom_consumer LANGUAGES NONE)
set(DEP_CUSTOM_SOURCE_DIR \"${source}\")
include(\"${module}\")
cppdeps_add(NAME custom GIT_REPOSITORY https://invalid.invalid/custom.git TAG v1
  BUILD_COMMAND \"\${CMAKE_COMMAND}\" -E touch <BINARY_DIR>/built.txt)
cppdeps_install_all()
get_property(mode GLOBAL PROPERTY CPPDEPS_CUSTOM_BUILD)
if(NOT mode STREQUAL ISOLATED)
  message(FATAL_ERROR \"Custom BUILD_COMMAND did not select ISOLATED: \${mode}\")
endif()
")
set(gen_args)
if(DEFINED CPPDEPS_TEST_GENERATOR AND NOT CPPDEPS_TEST_GENERATOR STREQUAL "")
  list(APPEND gen_args -G "${CPPDEPS_TEST_GENERATOR}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${gen_args} -S "${work}/consumer" -B "${work}/build"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "custom configure failed:\n${out}\n${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/build"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "custom build failed:\n${out}\n${err}")
endif()
if(NOT EXISTS "${work}/build/_cppdeps/isolated/build/custom/built.txt")
  message(FATAL_ERROR "Custom command did not create its output")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "isolated custom command test passed")
