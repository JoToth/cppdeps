cmake_minimum_required(VERSION 3.20)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_work "${CMAKE_CURRENT_BINARY_DIR}/tmp/local_override_offline")
file(REMOVE_RECURSE "${_work}")
file(MAKE_DIRECTORY "${_work}/local")
file(WRITE "${_work}/local/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)\n")
set(CPPDEPS_OFFLINE ON CACHE BOOL "" FORCE)
set(CPPDEPS_STRICT_LOCK ON CACHE BOOL "" FORCE)
set(CPPDEPS_LOCKFILE "${_work}/deps.lock.cmake" CACHE FILEPATH "" FORCE)
set(DEP_TESTDEP_SOURCE_DIR "${_work}/local")
include("${_root}/cmake/CppDeps.cmake")
cppdeps_add(NAME testdep GIT_REPOSITORY "https://invalid.example/no-repository.git" HEAD_OF_BRANCH main BUILD NONE)
cppdeps_install_all(WRITE_LOCKFILE)
get_property(_src GLOBAL PROPERTY CPPDEPS_TESTDEP_SOURCE_DIR)
if(NOT _src STREQUAL "${_work}/local")
  message(FATAL_ERROR "Offline local source override not selected: ${_src}")
endif()
file(READ "${CPPDEPS_LOCKFILE}" _lock)
if(_lock MATCHES "CPPDEPS_LOCK_TESTDEP_COMMIT")
  message(FATAL_ERROR "Local source override should not create a fake Git lock")
endif()
file(REMOVE_RECURSE "${_work}")
